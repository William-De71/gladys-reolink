{
  "name": "gladys-reolink",
  "version": "1.3.0",
  "private": true,
  "description": "External integration to use your Reolink cameras from Gladys Assistant.",
  "homepage": "https://github.com/William-De71/gladys-reolink",
  "repository": {
    "type": "git",
